# Buildmetrics AI - Environment Configuration Example

# --------------------------
# AI Provider (Required)
# --------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# --------------------------
# Database Connection
# --------------------------
# If using Docker Compose, uncomment the Postgres URL:
# DATABASE_URL=postgresql://buildmetrics:supersecret@db:5432/buildmetrics
# For local dev without Postgres, leave commented to fallback to sqlite:///buildmetrics.db
# DATABASE_URL=sqlite:///buildmetrics.db

# --------------------------
# API Connections
# --------------------------
# The Streamlit UI needs to know where the FastAPI service is located.
# For Docker Compose, this should be the service name:
API_BASE_URL=http://api:8000
# For local bare-metal dev, this should be:
# API_BASE_URL=http://localhost:8000
