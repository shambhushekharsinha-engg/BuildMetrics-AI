# ═══════════════════════════════════════════════════════════════════════════════
# BuildMetrics AI — Environment Configuration
# Copy this file to `.env` and fill in the values.
# ═══════════════════════════════════════════════════════════════════════════════

# ─── AI Provider (Required) ───────────────────────────────────────────────────
# Get your key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Database Connection ──────────────────────────────────────────────────────
# For Docker Compose (PostgreSQL):
DATABASE_URL=postgresql://buildmetrics:supersecret@db:5432/buildmetrics
# For local bare-metal dev (SQLite fallback, no external DB needed):
# DATABASE_URL=sqlite:///buildmetrics.db

# ─── API Connections ──────────────────────────────────────────────────────────
# The Streamlit UI must know where the FastAPI backend is located.
# For Docker Compose, use the service name:
API_BASE_URL=http://api:8000
# For local bare-metal dev:
# API_BASE_URL=http://localhost:8000

# ─── Redis / Celery Task Queue ────────────────────────────────────────────────
# Required for async export (PDF, ZIP bundle). Leave blank to use sync export.
# For Docker Compose (uses redis service):
REDIS_URL=redis://redis:6379/0
# For local bare-metal dev:
# REDIS_URL=redis://localhost:6379/0

# ─── CORS Security ────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for the FastAPI CORS middleware.
# Use * for development (allows all origins).
# Set to your actual domain(s) in production!
ALLOWED_ORIGINS=*
# Production example:
# ALLOWED_ORIGINS=https://buildmetrics.yourdomain.com,https://api.yourdomain.com

# ─── Environment Tag ──────────────────────────────────────────────────────────
# Affects logging verbosity and Sentry error grouping.
# Options: development | staging | production
ENVIRONMENT=development

# ─── Error Tracking (Optional) ────────────────────────────────────────────────
# Get your DSN from https://sentry.io
# Leave blank to disable Sentry integration.
SENTRY_DSN=

# ─── Shared Export Directory ──────────────────────────────────────────────────
# Directory shared between the API and Celery worker for generated export files.
# Must be the same path on both services (use a Docker volume in production).
SHARED_EXPORT_DIR=/app/exports
